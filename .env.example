# Capital.com credentials
# Copy this file to .env, then fill in the values below.
# Never commit your real .env file.

CAPITAL_EMAIL=
CAPITAL_API_KEY=
CAPITAL_API_PASSWORD=

# Optional: only set this when you explicitly want to switch to a specific
# Capital.com financial account after login.
CAPITAL_ACCOUNT_ID=

# Optional local dashboard settings.
# Keep 127.0.0.1 for localhost-only access. Use 0.0.0.0 only on a trusted LAN.
CFD_WEB_HOST=127.0.0.1

# Optional fixed dashboard control token.
# Leave blank to generate a secure one-run token automatically.
CFD_WEB_TOKEN=

# Optional creator-consensus integrations.
# YouTube works without API credentials. Twitch and Kick use official app
# credentials and the bot obtains short-lived app access tokens automatically.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

